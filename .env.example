# Required for Gmail SMTP. Use a Gmail app password, not your regular password.
EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_RECEIVER=you@example.com

# ChatGPT Plus and the OpenAI API are billed separately. Create an API key
# in the OpenAI API platform and put it here.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium

# Optional overrides
SOURCE_PAGE_URL=https://economictimes.indiatimes.com/industry/renewables/solar-energy
SOURCE_POWER_PAGE_URL=https://economictimes.indiatimes.com/industry/energy/power
SOURCE_RENEWABLES_PAGE_URL=https://economictimes.indiatimes.com/industry/renewables
SOURCE_INFRASTRUCTURE_PAGE_URL=https://economictimes.indiatimes.com/news/economy/infrastructure
SOURCE_POLICY_PAGE_URL=https://economictimes.indiatimes.com/news/economy/policy
POLL_INTERVAL_SECONDS=900
STATE_FILE=state.json
MAX_ARTICLES_PER_RUN=10
# Archive articles are never eligible for new-story alerts beyond this age.
MAX_STORY_AGE_HOURS=24
ARTICLE_MAX_CHARS=18000
REQUEST_TIMEOUT_SECONDS=30
# Optional fixed subject override; by default the monitored page names are used.
# EMAIL_SUBJECT_PREFIX=[ET News]
